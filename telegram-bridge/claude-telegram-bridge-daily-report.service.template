# systemd --user unit template for the daily_report.py one-shot job (Linux).
# Optional - skip both this file and the matching .timer template entirely
# if you don't want a daily digest. Paired with
# claude-telegram-bridge-daily-report.timer.template, which triggers it once
# a day - this .service file alone does NOT run on a schedule by itself.
# See SETUP.md section (i).
#
# BEFORE INSTALLING, replace every <PLACEHOLDER> below (same values as
# claude-telegram-bridge.service.template - keep them consistent):
#   <PYTHON3_PATH>    - absolute path to python3
#   <BRIDGE_DIR>      - absolute path to this telegram-bridge/ directory
#   <EXTRA_PATH_DIRS> - see the PATH note in claude-telegram-bridge.service.template
#
# Install (rename both this file and the .timer file, drop .template):
#   cp claude-telegram-bridge-daily-report.service ~/.config/systemd/user/
#   cp claude-telegram-bridge-daily-report.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-telegram-bridge-daily-report.timer

[Unit]
Description=Claude Telegram bridge - daily activity digest (one-shot, triggered by the matching .timer)

[Service]
Type=oneshot
WorkingDirectory=<BRIDGE_DIR>
Environment=PATH=<EXTRA_PATH_DIRS>:/usr/local/bin:/usr/bin:/bin
ExecStart=<PYTHON3_PATH> <BRIDGE_DIR>/daily_report.py
