TELEGRAM_BOT_TOKEN=your_bot_token_here       # from @BotFather after /newbot
TELEGRAM_CHAT_ID=your_chat_id_here            # see SETUP.md step (a) - curl getUpdates, get_chat_id.py, or @userinfobot
CLAUDE_DEFAULT_CWD=/path/to/default/project   # working directory claude -p will run in (classic mode only)

# RELAY_MODE (recommended default for a coordinator setup; off = classic
# standalone mode with its own headless `claude -p`, no shared context with
# any live session). Set to 1/true/yes to instead append each incoming
# authorized message to relay-inbox.jsonl for a LIVE Claude Code session to
# pick up; the bot only 👀-reacts, and the live session replies via notify.sh
# and sets the final 👍/👎 reaction via react.sh. See SETUP.md.
RELAY_MODE=1

# --- Idle status post (RELAY_MODE only; see SETUP.md "Founder features") ---
# After IDLE_STATUS_AFTER_MINUTES with no message either way, bot.py posts a
# silent status message; while it stays quiet it re-checks every
# IDLE_STATUS_REFRESH_MINUTES and edits the post only if the status changed;
# the next message in either direction deletes it. configure_bridge.py adds
# these and fills in the status source for each project - run it rather
# than editing by hand. Values it writes are single-quoted on purpose:
# notify.sh `source`s this file, so an unquoted command would execute.
IDLE_STATUS_ENABLED=1
IDLE_STATUS_AFTER_MINUTES=45
IDLE_STATUS_REFRESH_MINUTES=40
IDLE_STATUS_SILENT=1
# Comma-separated absolute paths; a STATE.md contributes its "## Current" section.
#STATUS_FILES='/abs/path/to/project/docs/coordination/STATE.md'
# Shell commands printing a status block, one per project, joined by " ;; "
# (plugin installs: coord.py ... status).
#STATUS_COMMANDS='python3 /abs/path/to/plugin/scripts/coord.py --root /abs/path/to/project status'

# DIGEST_ALWAYS_SEND (optional escape hatch for daily_report.py). By
# default the daily digest only sends when today's git activity looks
# significant: a commit-volume spike over a trailing 7-day baseline, or a
# commit message hits a flagged keyword (revert, hotfix, security,
# incident, outage, regression, ...). Routine days send nothing at all,
# and the "last reported" marker does not advance, so quiet-day commits
# fold into whichever future report does send. Set to 1/true/yes to
# bypass the gate and go back to sending a digest unconditionally every
# run (including a "nothing new" notice on a quiet day). See SETUP.md
# section (k) "Optional: daily activity digest".
DIGEST_ALWAYS_SEND=0

# TELEGRAM_API_BASE (optional, Windows-path-only). Overrides the Telegram
# Bot API base URL used by this directory's Windows PowerShell (.ps1)
# scripts - e.g. pointed at a local fake-Telegram HTTP stub while
# developing/testing those scripts. Defaults to https://api.telegram.org
# when unset. The Unix .sh scripts do NOT read this variable - they are
# required to stay byte-identical to their pre-Windows-support form (see
# SETUP.md "Windows (Task Scheduler)"), so this override only affects
# notify.ps1/react.ps1/typing.ps1/send-file.ps1/register-commands.ps1.
#TELEGRAM_API_BASE=https://api.telegram.org

# --- Optional: email monitor (email_monitor.py) ---------------------------
# See SETUP.md section (l) "Optional: email monitor" and EMAIL-MONITOR.md
# for full setup. Skip this whole block if you don't want it.

IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
IMAP_USER=you@yourdomain.example
# For Gmail, this MUST be a Google APP password (Google Account > Security >
# 2-Step Verification > App passwords) - requires 2FA enabled first - NOT
# your regular account password. Other providers vary; check their docs.
# Left empty, email_monitor.py logs a warning and skips the poll cycle.
IMAP_PASSWORD=

# Optional comma-separated list of domains to filter recipients against (a
# message is only recorded if it was addressed - To/Cc/Delivered-To/etc. -
# to one of these domains). Unset/blank = no filtering, everything in the
# account is recorded.
#MONITOR_DOMAINS=example.org
